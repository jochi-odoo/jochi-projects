<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_sync_company_id" model="ir.actions.server">
        <field name="name">Sync company_id from x_company_ids</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">
<![CDATA[
record['company_id'] = record.x_company_ids[:1].id if record.x_company_ids[:1] else False
]]>
        </field>
    </record>

    <record id="action_sync_active_company_id" model="ir.actions.server">
        <field name="name">Sync active company id to company_id</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">
<![CDATA[
partners = env['res.partner'].search([])
for partner in partners:
    if env.company.id in partner.x_company_ids:
        partner['company_id'] = env.company.id
]]>
        </field>
    </record>
    
    <record id="action_activate_company" model="ir.actions.server">
        <field name="name">Activate company</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">
<![CDATA[

]]>
        </field>
    </record>

    <record id="action_remove_company_id" model="ir.actions.server">
        <field name="name">Remove company_id</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">
<![CDATA[
]]>
        </field>
    </record>
</odoo>
