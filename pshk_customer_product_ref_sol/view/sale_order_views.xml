<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ext_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ext.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="before">
                <field name="x_external_reference_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
