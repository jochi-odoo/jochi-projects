<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Hide the stock_account serial number table when setting is enabled -->
    <template id="hide_stock_account_snln_table" inherit_id="stock_account.stock_account_report_invoice_document">
        <xpath expr="//table[@name='invoice_snln_table']" position="attributes">
            <attribute name="t-if">not (o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice')</attribute>
        </xpath>
    </template>

    <!-- Add Lots/SN column when setting is enabled -->
    <template id="report_invoice_document_lots_sn_column" inherit_id="account.report_invoice_document">
        
        <!-- Add column header for Lots/SN after Description -->
        <xpath expr="//table[@name='invoice_line_table']//thead//th[@name='th_description']" position="after">
            <th t-if="o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice'" name="th_lots_sn" class="text-start">
                <span>Serial Number / Lot Number</span>
            </th>
        </xpath>
        
        <!-- Add separate rows for each lot/SN before the original product row -->
        <xpath expr="//t[@t-if='not hide_details and not hide_prices']/tr" position="before">
            <t t-if="is_product and o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice'">
                <t t-set="stock_move_lines" t-value="line.invoice_line_ids.move_ids.move_line_ids.filtered(lambda sml: sml.state == 'done' and sml.lot_id and sml.product_id == line.product_id)"/>
                <t t-foreach="stock_move_lines" t-as="sml">
                    <tr>
                        <td name="account_invoice_line_name" t-att-class="padding_class">
                            <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
                        </td>
                        <td name="td_lots_sn" class="text-start">
                            <span t-field="sml.lot_id.name"/>
                        </td>
                        <td name="td_quantity" class="o_td_quantity text-end">
                            <span t-field="sml.quantity" class="text-nowrap"/>
                        </td>
                        <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span t-if="not hide_prices" class="text-nowrap" t-field="line.price_unit"/>
                        </td>
                        <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-field="line.discount"/>
                        </td>
                        <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                        <td name="td_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                            <span t-if="not hide_prices" t-out="taxes" id="line_tax_ids"/>
                        </td>
                        <td name="td_subtotal" class="text-end o_price_total">
                            <t t-set="line_ratio" t-value="sml.quantity / line.quantity if line.quantity else 0.0"/>
                            <span t-if="not hide_prices and o.company_price_include == 'tax_excluded'" class="text-nowrap" 
                                t-out="line.price_subtotal * line_ratio" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            <t t-if="not hide_prices and o.company_price_include == 'tax_included'">
                                <span class="text-nowrap" t-out="line.price_total * line_ratio" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </t>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
        
        <!-- Hide original row when lots are present and setting is enabled -->
        <xpath expr="//t[@t-if='not hide_details and not hide_prices']/tr" position="attributes">
            <attribute name="t-if">not (is_product and o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice' and line.sale_line_ids.move_ids.move_line_ids.filtered(lambda sml: sml.state == 'done' and sml.lot_id and sml.product_id == line.product_id))</attribute>
        </xpath>
        
        <!-- Add Lots/SN cell to original row for products without lots -->
        <xpath expr="//t[@t-if='is_product'][@name='account_invoice_line_accountable']/td[@name='account_invoice_line_name']" position="after">
            <td t-if="o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice'" name="td_lots_sn_empty" class="text-start">
            </td>
        </xpath>
        
        <!-- Update colspan for section/subsection lines to include new column -->
        <xpath expr="//td[@name='line_name_td']" position="replace">
            <td name="line_name_td"
                t-att-colspan="(1 if is_product else (line_colspan + (1 if o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice' else 0)))"
                t-attf-class="{{'d-none d-md-table-cell' if report_type == 'html' else ''}} {{padding_class}}">
                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
            </td>
        </xpath>
        
        <!-- Update colspan for note lines to include new column -->
        <xpath expr="//t[@t-elif='is_note']/td" position="replace">
            <td t-att-colspan="100 if o.company_id.x_combine_lots_sn_picking_report and o.type_name == 'Invoice' else 99">
                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}"/>
            </td>
        </xpath>
        
    </template>

</odoo>
