<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_res_partner__x_company_ids" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="name">x_company_ids</field>
        <field name="field_description">Companies Visibility</field>
        <field name="ttype">many2many</field>
        <field name="relation">res.company</field>
        <field name="compute">
for record in self:
    if record['company_id'] and record['company_id'] not in record['x_company_ids']:
        record['x_company_ids'] = [record['company_id'].id, *record['x_company_ids'].ids]
        </field>
        <field name="depends">company_id</field>
        <field name="store">True</field>
    </record>
</odoo>
