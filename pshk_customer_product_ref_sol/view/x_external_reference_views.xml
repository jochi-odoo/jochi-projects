<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="x_external_reference_view_list" model="ir.ui.view">
        <field name="name">x_external_reference.list</field>
        <field name="model">x_external_reference</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_ext_ref_product_id"/>
                <field name="x_ext_ref_partner_id"/>
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <record id="x_external_reference_view_form" model="ir.ui.view">
        <field name="name">x_external_reference.form</field>
        <field name="model">x_external_reference</field>
        <field name="arch" type="xml">
            <form string="External Reference">
                <sheet>
                    <group>
                        <field name="x_ext_ref_product_id"/>
                        <field name="x_ext_ref_partner_id"/>
                        <field name="x_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="x_external_reference_action" model="ir.actions.act_window">
        <field name="name">External Reference</field>
        <field name="res_model">x_external_reference</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_external_reference" name="External Reference" parent="sale.sale_menu_root" action="x_external_reference_action" sequence="99" groups="sales_team.group_sale_salesman"/>

</odoo>
