<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="base.res_partner_rule" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="res_partner_multi_company_contact" model="ir.rule">
            <field name="name">res.partner: multi company</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">['|', '|', ('partner_share', '=', False), ('x_company_ids', 'parent_of', company_ids), ('x_company_ids', '=', False)]</field>
        </record>
    </data>

</odoo>
